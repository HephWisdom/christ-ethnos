MONGODB_URI=mongodb://127.0.0.1:27017/church-site
MONGODB_DB=church-site
PORT=4000
ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Comma-separated frontend origins. Avoid "*" in production.
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=32kb
# Optional when the frontend is hosted separately from the API server.
VITE_API_URL=
