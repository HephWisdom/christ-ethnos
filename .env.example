MONGODB_URI=mongodb://127.0.0.1:27017/church-site
MONGODB_DB=church-site
PORT=4000
ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Comma-separated frontend origins. Avoid "*" in production.
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=32kb
# Global per-IP request limiter. Use CDN/WAF limits in production too.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Optional when the frontend is hosted separately from the API server.
VITE_API_URL=
# Public site URL used to build absolute image URLs in emails.
PUBLIC_SITE_URL=https://christethnos.org
# Resend acknowledgement emails for prayer requests and Zoom link requests.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Christ Ethnos <hello@your-verified-domain.com>"
# Optional reply-to address for acknowledgement emails.
RESEND_REPLY_TO_EMAIL=
# Optional absolute logo URL shown inside outgoing emails. Defaults to PUBLIC_SITE_URL/favicon.png.
EMAIL_LOGO_URL=
# Internal recipient for prayer and Zoom-link notifications.
FORM_NOTIFICATION_EMAIL=info@christethnos.org
# Optional public ministry name used in email templates.
SITE_NAME="Christ Ethnos Global Ministries"
